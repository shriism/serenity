{
  "name": "serenity",
  "version": "0.1.0",
  "description": "A human-AI personal knowledge environment",
  "author": "sriyan",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:desktop": "npm run build && tsx tests/desktop-smoke.ts",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run icons && npm run build && electron-builder --publish never",
    "dist:mac": "npm run icons && npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run icons && npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run icons && npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "app.serenity.desktop",
    "productName": "Serenity",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/@github/copilot-sdk-*/**/*",
      "node_modules/@openai/codex-*/**/*"
    ],
    "mac": {
      "icon": "build/icons/app.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icons/app.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icons",
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@github/copilot-sdk": "^1.0.14",
    "@openai/codex-sdk": "^0.156.0",
    "chokidar": "^4.0.3",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "icon-gen": "^5.0.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "electron@44.4.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
